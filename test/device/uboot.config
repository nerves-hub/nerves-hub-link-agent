# Config fragment merged over qemu_arm64_defconfig.
#
# Debian's prebuilt u-boot is close but missing the one thing rollback needs,
# and has one thing that does not work.

# The whole point of the source build. Without it u-boot has no notion of a
# boot attempt, and rollback has to be hand-rolled in a script — which is where
# the previous attempt ran aground.
CONFIG_BOOTCOUNT_LIMIT=y

# Keep the count in u-boot's own environment rather than a dedicated register
# or RTC scratch. It is the portable choice, and on this machine the
# environment lives in pflash, which persists once QEMU is given a backing file.
CONFIG_BOOTCOUNT_ENV=y

# Read the metadata environment off the disk. `env import` is used read-only —
# u-boot 2023.01's `env export -c` produces a blob its own `env import -c`
# rejects, so nothing here writes that block. fwup and Linux own it.
CONFIG_CMD_IMPORTENV=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_VIRTIO=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_SETEXPR=y
