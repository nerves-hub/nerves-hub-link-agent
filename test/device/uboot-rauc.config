# Config fragment for the RAUC rig's u-boot, merged over qemu_arm64_defconfig.
#
# The environment moves to an SD card, and the reason is worth writing down
# because three more obvious options do not work on this machine:
#
#   * u-boot's default is pflash, which Debian's arm64 kernel cannot see. There
#     is no CFI or physmap driver, /proc/mtd stays empty, and `fw_setenv` has no
#     device to write.
#   * There is no raw-block environment driver for virtio, so the environment
#     cannot sit at a fixed offset on the disk the way fwup's metadata does.
#   * Putting it in a file on an ext4 partition fails twice over: u-boot loads
#     its environment before virtio is enumerated, so the load never succeeds
#     and every boot starts from defaults; and its ext4 writer refuses a
#     filesystem made by a current mke2fs.
#
# An SD card sidesteps all three, and not by luck. Raw-block environments on
# MMC are what real devices use, which is why u-boot has a driver for them and
# none for virtio. Linux sees the same card as /dev/mmcblk0, so `fw_setenv` —
# and therefore RAUC — writes the bytes u-boot reads.
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_IS_IN_FLASH=n
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_ENV_OFFSET=0x80000
CONFIG_ENV_SIZE=0x20000

# QEMU's card is an `sdhci-pci`, so u-boot needs the generic SDHCI driver and
# its PCI glue.
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_PCI=y
CONFIG_CMD_MMC=y

CONFIG_CMD_VIRTIO=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_SETEXPR=y
